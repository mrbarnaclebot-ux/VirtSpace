//
//  Secrets.swift.example
//  VirtSpace
//
//  ── Secrets pattern ──────────────────────────────────────────────────────
//  This is the COMMITTED template. The `.example` (non-.swift) extension keeps
//  it out of the Xcode build. To set up a checkout, copy this file to
//  `Secrets.swift` (which is gitignored) and fill in the dev-auth token.
//
//  In AUTH_MODE=dev the backend accepts a static bearer token plus an
//  `x-dev-user` header identifying the dev user. Real Sign in with Apple lands
//  in a later stage; nothing secret ever ships in a production build.
//  ─────────────────────────────────────────────────────────────────────────
//

import Foundation

enum Secrets {
    /// Base URL of the VirtSpace backend (Railway, production).
    static let apiBaseURL = "https://api-production-dbd38.up.railway.app"

    /// Dev-auth bearer token. Replace locally; never commit a real value.
    static let devAuthToken = "REPLACE_ME"

    /// Dev-auth user identity, sent as the `x-dev-user` header.
    static let devUserId = "device-dev@virtspace.dev"
}
