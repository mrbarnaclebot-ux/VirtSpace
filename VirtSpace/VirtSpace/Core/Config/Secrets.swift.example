//
//  Secrets.swift.example
//  VirtSpace
//
//  ── Secrets pattern ──────────────────────────────────────────────────────
//  This is the COMMITTED template. The `.example` (non-.swift) extension keeps
//  it out of the Xcode build. To set up a checkout, copy this file to
//  `Secrets.swift` (which is gitignored) and fill in the dev-auth token:
//
//      cp Secrets.swift.example Secrets.swift
//
//  `apiBaseURL` deliberately defaults to LOCALHOST (spec §10 R5). A fresh
//  checkout that forgets to edit this file therefore talks to a local mock
//  backend, not the owner's production Railway deployment — a simulator run
//  against production once uploaded 28 test frames into the real library and
//  burned the day's scan quota. Point it at production only on purpose, and
//  note that DEBUG **simulator** builds refuse a production host outright
//  unless `VIRTSPACE_ALLOW_PROD=1` is set in the scheme's environment
//  (see `APIClient.defaultBaseURL`). DEBUG builds on a physical device are
//  unaffected — that is the owner's normal free-provisioning workflow.
//
//  ── Honest note on the dev-auth token ────────────────────────────────────
//  In AUTH_MODE=dev the backend accepts a static bearer token plus an
//  `x-dev-user` header identifying the dev user. `devAuthToken` below is a
//  COMPILED-IN STRING: it ships inside the app binary and IS recoverable from
//  it (`strings VirtSpace.app/VirtSpace` will print it). It is not protected
//  by being gitignored — the gitignore only keeps it out of the repo. Treat it
//  as a development-only credential, keep the backend's `AUTH_MODE=dev` off in
//  production, and rotate the token if a build leaves your machine. Real Sign
//  in with Apple replaces this whole path in a later stage.
//  ─────────────────────────────────────────────────────────────────────────
//

import Foundation

enum Secrets {
    /// Base URL of the VirtSpace backend. Defaults to a local backend/mock;
    /// change it only when you mean to talk to a deployed environment.
    static let apiBaseURL = "http://localhost:8080"

    /// Dev-auth bearer token. Replace locally; never commit a real value.
    /// Recoverable from the built binary — see the header note.
    static let devAuthToken = "REPLACE_ME"

    /// Dev-auth user identity, sent as the `x-dev-user` header.
    static let devUserId = "device-dev@virtspace.dev"
}
